{
	"$schema": "http://schema.management.azure.com/schemas/2015-01-01/deploymentTemplate.json#",
	"contentVersion": "1.0.0.0",
	"parameters": {
		"factoryName": {
			"type": "string",
			"metadata": "Data Factory name",
			"defaultValue": "azure-pipeline-adf"
		},
		"Delta_lake_accountKey": {
			"type": "secureString",
			"metadata": "Secure string for 'accountKey' of 'Delta_lake'"
		},
		"Onprem_DB_password": {
			"type": "secureString",
			"metadata": "Secure string for 'password' of 'Onprem_DB'"
		},
		"Delta_lake_properties_typeProperties_url": {
			"type": "string",
			"defaultValue": "https://azurepipelinedeltalake.dfs.core.windows.net/"
		},
		"Onprem_DB_properties_typeProperties_server": {
			"type": "string",
			"defaultValue": "localhost"
		},
		"Onprem_DB_properties_typeProperties_database": {
			"type": "string",
			"defaultValue": "vCX360DataStore"
		},
		"Onprem_DB_properties_typeProperties_userName": {
			"type": "string",
			"defaultValue": "sa"
		},
		"Rest_properties_typeProperties_url": {
			"type": "string",
			"defaultValue": "https://pokeapi.co/api/v2/pokemon/"
		},
		"containerUri": {
			"type": "string",
			"metadata": "URI to storage account containing linked ARM templates"
		},
		"containerSasToken": {
			"type": "string",
			"metadata": "Sas token to storage account containing linked ARM templates"
		}
	},
	"variables": {
		"factoryId": "[concat('Microsoft.DataFactory/factories/', parameters('factoryName'))]"
	},
	"resources": [
		{
			"name": "azure-pipeline-adf_ArmTemplate_0",
			"type": "Microsoft.Resources/deployments",
			"apiVersion": "2024-03-01",
			"properties": {
				"mode": "incremental",
				"templateLink": {
					"uri": "[concat(parameters('containerUri'), '/ArmTemplate_0.json', parameters('containerSasToken'))]",
					"contentVersion": "1.0.0.0"
				},
				"parameters": {
					"factoryName": {
						"value": "[parameters('factoryName')]"
					},
					"Delta_lake_accountKey": {
						"value": "[parameters('Delta_lake_accountKey')]"
					},
					"Onprem_DB_password": {
						"value": "[parameters('Onprem_DB_password')]"
					},
					"Delta_lake_properties_typeProperties_url": {
						"value": "[parameters('Delta_lake_properties_typeProperties_url')]"
					},
					"Rest_properties_typeProperties_url": {
						"value": "[parameters('Rest_properties_typeProperties_url')]"
					},
					"Onprem_DB_properties_typeProperties_server": {
						"value": "[parameters('Onprem_DB_properties_typeProperties_server')]"
					},
					"Onprem_DB_properties_typeProperties_database": {
						"value": "[parameters('Onprem_DB_properties_typeProperties_database')]"
					},
					"Onprem_DB_properties_typeProperties_userName": {
						"value": "[parameters('Onprem_DB_properties_typeProperties_userName')]"
					}
				}
			},
			"dependsOn": []
		}
	]
}